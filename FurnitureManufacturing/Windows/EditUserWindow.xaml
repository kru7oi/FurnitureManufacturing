<Window x:Class="FurnitureManufacturing.Windows.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FurnitureManufacturing.Windows"
        mc:Ignorable="d"
        Title="Изменение данных" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
            <RowDefinition Height="40" />
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин:"/>
        <TextBox Name="LoginTb" Grid.Column="2" Text="{Binding Login}"/>
        <TextBlock Grid.Row="2" Text="Пароль:"/>
        <TextBox Name="PasswordTb" Grid.Row="2" Grid.Column="2" Text="{Binding Password}"/>
        <TextBlock Grid.Row="4" Text="Роль:"/>
        <TextBox Name="RoleTb" Grid.Row="4" Grid.Column="2" Text="{Binding RoleId}"/>
        <TextBlock Grid.Row="5" Grid.Column="2" FontSize="12" Text="1 - администратор; 2 - пользователь" VerticalAlignment="Top"/>
        <CheckBox Name="IsBlockedCb" Grid.Row="6" Grid.Column="2" Content="Блокировка" IsChecked="{Binding IsBlocked}" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <Button Name="EditUserBtn" Grid.Row="8" Grid.Column="2" Content="Изменить" Click="EditUserBtn_Click"/>
    </Grid>
</Window>

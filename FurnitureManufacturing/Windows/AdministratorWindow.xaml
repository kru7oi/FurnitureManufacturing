<Window x:Class="FurnitureManufacturing.Windows.AdministratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FurnitureManufacturing.Windows"
        xmlns:converter="clr-namespace:FurnitureManufacturing.Converters"
        mc:Ignorable="d"
        Title="Окно администратора" WindowStartupLocation="CenterScreen" Height="720" Width="1280">
    <Window.Resources>
        <converter:BoolToTextConverter x:Key="BoolToTextConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Button Name="AddUserBtn" Content="Добавить" Click="AddUserBtn_Click"/>
            <Button Name="EditUserBtn" Grid.Column="2" Content="Изменить данные" Click="EditUserBtn_Click"/>
        </Grid>

        <ListView Name="UsersLv" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}"/>
                    <GridViewColumn Header="Пароль" DisplayMemberBinding="{Binding Password}"/>
                    <GridViewColumn Header="Роль в системе" DisplayMemberBinding="{Binding Role.RoleName}"/>
                    <GridViewColumn Header="Блокировка" DisplayMemberBinding="{Binding IsBlocked, Converter={StaticResource BoolToTextConverter}}"/>
                    <GridViewColumn Header="Дата создания" DisplayMemberBinding="{Binding CreatedDate, StringFormat=dd.MM.yyyy HH:mm:ss}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
